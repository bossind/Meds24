# Server Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:password@localhost:5432/meds24"

# Telegram Bot Token (Obtained from @BotFather)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Telegram Admin Chat ID (For receiving instant order alerts)
TELEGRAM_ADMIN_CHAT_ID=""

# Comma-separated list of authorized Telegram User IDs for Admin Mini App access
TELEGRAM_ADMIN_IDS=""

# Deployed HTTPS URL of the Telegram Mini App (e.g., https://meds24-app.onrender.com/admin-mini-app)
TELEGRAM_MINI_APP_URL=""

# Session Secret for cookie signing
SESSION_SECRET="generate_random_secure_string_here"

# Admin Web Passcode Hash (Optional, defaults to admin123 if not set)
ADMIN_PASSCODE_HASH=""

# Public Base URL of the Application
APP_BASE_URL="http://localhost:3000"
